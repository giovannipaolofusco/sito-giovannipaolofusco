# Header di sicurezza e di cache; scripts/build.mjs lo copia in dist/.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; style-src 'self'; script-src 'self' https://www.googletagmanager.com; font-src 'self'; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.analytics.google.com https://*.google.com; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# Nomi senza hash: una cache lunga congelerebbe gli asset presso chi ha gia' visitato il sito.
/assets/*
  Cache-Control: public, max-age=86400, must-revalidate

# CSS e JS si rivalidano a ogni visita, cosi' un deploy non resta fermo in cache.
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

# I font sono l'unico caso in cui il nome cambia sempre col contenuto.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# L'informativa dei corsi si apre dal questionario: consultabile, fuori dai risultati di ricerca.
/privacy-corsi/*
  X-Robots-Tag: noindex

# Mai cache immutabile su HTML, service worker e manifest.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Senza Content-Type esplicito Netlify lo serve come application/octet-stream.
/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400, must-revalidate

# Con text/plain la vCard si apre in una scheda invece di entrare in rubrica.
/contatto.vcf
  Content-Type: text/vcard; charset=utf-8
  Cache-Control: public, max-age=86400, must-revalidate
