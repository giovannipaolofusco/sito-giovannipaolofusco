# Header di risposta — CLAUDE.md §6.9 (sicurezza) e §6.10 (cache).
# scripts/build.mjs lo copia cosi' com'e' nella cartella pubblicata, dist/.

/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: geolocation=(), microphone=(), camera=()
  Content-Security-Policy: default-src 'self'; img-src 'self' data: https://www.googletagmanager.com https://*.google-analytics.com; style-src 'self'; script-src 'self' https://www.googletagmanager.com; font-src 'self'; connect-src 'self' https://www.googletagmanager.com https://*.google-analytics.com https://*.google.com; worker-src 'self'; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'

# /assets/* : revalidation quotidiana. Il progetto non versiona i nomi file
# (niente hash nel nome), quindi una cache lunga congelerebbe per un anno un
# CSS corretto oggi presso chi ha gia' visitato il sito.
/assets/*
  Cache-Control: public, max-age=86400, must-revalidate

# CSS e JavaScript non hanno nomi con hash: ogni visita li rivalida nel browser,
# e sw.js li chiede prima alla rete, cosi' un deploy non resta fermo in nessuna cache.
/assets/css/*
  Cache-Control: public, max-age=0, must-revalidate

/assets/js/*
  Cache-Control: public, max-age=0, must-revalidate

# I font sono l'unico caso in cui il nome cambia sempre col contenuto.
/assets/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Mai cache immutabile su HTML, service worker e manifest.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

# Senza Content-Type esplicito Netlify lo serve come application/octet-stream.
/site.webmanifest
  Content-Type: application/manifest+json
  Cache-Control: public, max-age=86400, must-revalidate

# La vCard va servita come text/vcard: con text/plain il file si apre in una
# scheda del browser e il contatto non entra in rubrica, senza alcun errore
# visibile. La verifica che vale e' su un telefono reale, non su questo file.
/contatto.vcf
  Content-Type: text/vcard; charset=utf-8
  Cache-Control: public, max-age=86400, must-revalidate
